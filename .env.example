# Copy this file to .env and fill in a key. Never share or commit .env.

# Which LLM to use: groq (free tier) or xai (Grok, needs paid credits)
LLM_PROVIDER=groq

# Groq key, starts with gsk_   -> https://console.groq.com/keys
GROQ_API_KEY=

# xAI Grok key, starts with xai-   -> https://console.x.ai
XAI_API_KEY=

# Optional overrides
# FAST_MODEL=openai/gpt-oss-20b       # Profiler Agent
# SMART_MODEL=openai/gpt-oss-120b     # Action Agent
# LLM_TOKENS_PER_MINUTE=7500          # stay under the provider's per-minute token limit
# LLM_DISABLED=1                      # force rules-only mode
